{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "USG Meeting Minutes Schema v1",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "meeting_id",
      "title",
      "participants",
      "summary"
    ],
    "properties": {
      "meeting_id": { "type": "string", "minLength": 1 },
      "title": { "type": "string", "minLength": 1 },
      "date_time": { "type": "string" },
      "participants": {
        "type": "array",
        "items": { "type": "string" }
      },
      "summary": { "type": "string" },
      "initiative_ids": {
        "type": "array",
        "items": { "type": "string" }
      },
      "buyer_ids": {
        "type": "array",
        "items": { "type": "string" }
      },
      "signal_ids": {
        "type": "array",
        "items": { "type": "string" }
      },
      "decisions": {
        "type": "array",
        "items": { "type": "string" }
      },
      "risks": {
        "type": "array",
        "items": { "type": "string" }
      },
      "next_actions": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "action": { "type": "string" },
            "owner": { "type": "string" },
            "due": { "type": "string" },
            "status": { "type": "string" }
          },
          "additionalProperties": true
        }
      },
      "source": {
        "type": "object",
        "properties": {
          "type": { "type": "string" },
          "link": { "type": "string" },
          "recorded_by": { "type": "string" },
          "submitted_by": { "type": "string" },
          "team_member": { "type": "string" },
          "confidence": { "type": "string" },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      },
      "visibility": { "type": "string" },
      "tags": {
        "type": "array",
        "items": { "type": "string" }
      },
      "created_at": { "type": "string" },
      "updated_at": { "type": "string" }
    },
    "additionalProperties": true
  }
}
